# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ── 虚拟环境 ──
venv/
.venv/

# ── 构建产物 ──
build/
dist/
*.spec.bak

# ── 外部工具二进制（ffmpeg / tesseract，按需单独放置） ──
tools/

